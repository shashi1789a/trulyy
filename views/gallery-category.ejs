<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= category.charAt(0).toUpperCase() + category.slice(1) %> Gallery</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f7f7f7;
      padding: 20px;
    }
    h1 {
      text-align: center;
      color: #333;
      margin-bottom: 20px;
    }
    .gallery-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      max-width: 1000px;
      margin: 0 auto;
    }
    .gallery-item {
      background-color: white;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      overflow: hidden;
      transition: transform 0.2s ease;
    }
    .gallery-item:hover {
      transform: scale(1.05);
      box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    }
    .gallery-item img {
      width: 100%;
      height: 150px;
      object-fit: cover;
      display: block;
    }
    .gallery-info {
      padding: 15px;
    }
    .gallery-info h3 {
      margin: 0 0 10px 0;
      font-size: 1.2em;
    }
    .gallery-info p {
      font-size: 0.9em;
      color: #666;
    }
    .back-link {
      display: block;
      text-align: center;
      margin: 20px 0;
      color: #007bff;
      text-decoration: none;
    }
    .back-link:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <h1><%= category.charAt(0).toUpperCase() + category.slice(1) %> Gallery</h1>
  <a href="/gallery" class="back-link">← Back to All Gallery</a>

  <% if (galleryImages.length > 0) { %>
    <div class="gallery-container">
      <% galleryImages.forEach(function(image) { %>
        <div class="gallery-item">
          <img src="<%= image.thumbnailUrl %>" alt="<%= image.altText || image.title %>" />
          <div class="gallery-info">
            <h3><%= image.title %></h3>
            <p><%= image.description %></p>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p style="text-align:center;">No images found in this category.</p>
  <% } %>
</body>
</html>
