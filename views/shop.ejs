<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Explore Places</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/stylesheet/shop.css">
</head>

<body class="bg-gray-100 font-[Poppins] text-gray-800">

  <%- include('./partials/header') %>
  <div class="body">
<!-- bodyheader -->
<div class="section">
<h1>
    JOURNEY TO  EXPLORE WORLD
</h1>
<P>Lorem ipsum dolor sit amet consectetur, adipisicing elit. Quaerat eaque expedita iusto assumenda vel hic amet dolore ipsum minima nulla? Rerum vero debitis ab delectus optio nihil doloribus saepe quia?</P>
<BUTTon>LEARN MORE</BUTTon>
<BUTTon>BOOK NOW</BUTTon>
</div>
</div>

  <section class="categories">
    <h2>Popular Categories</h2>
    <div class="category-grid">
      <div class="card"><a href="historical.html">🏰 Historical Places </a></div>
      <div class="card"> <a href="beaches.html">🏖️ Beaches</a></div>
      <div class="card">🌊 Waterfalls</div>
      <div class="card">🛕 Mountain</div>
    </div>
  </section>

  <h1 class="text-4xl font-bold text-center my-10 text-gray-900">Owner Submitted Places</h1>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 px-6 pb-12 max-w-7xl mx-auto">
    <% Product.forEach(function(product) { %>
      
      <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-transform hover:-translate-y-1">
        
        <% if (product.image) { %>
          <img src="data:image/jpeg;base64,<%= Buffer.from(product.image).toString('base64') %>"
               alt="<%= product.name %>"
               class="w-full h-52 object-cover rounded-t-xl"/>
        <% } else { %>
          <img src="/images/default.jpg"
               alt="Default Image"
               class="w-full h-52 object-cover rounded-t-xl"/>
        <% } %>

        <div class="p-5">
          <h2 class="text-xl font-bold text-gray-800 mb-2"><%= product.name %></h2>

          <p class="text-sm text-gray-600 mb-1">
            <i class="fa-solid fa-location-dot text-rose-500 mr-1"></i>
            <%= product.location.city %>, <%= product.location.country %>
          </p>

          <p class="text-sm text-gray-600 mb-1">
            <i class="fa-solid fa-tags text-teal-600 mr-1"></i>
            Category: <%= product.category %>
          </p>

          <p class="text-sm text-gray-600 mb-1">
            <i class="fa-solid fa-clock text-yellow-500 mr-1"></i>
            <%= product.openingHours.open %> - <%= product.openingHours.close %>
          </p>

          <p class="text-sm text-gray-600 mb-4">
            <i class="fa-solid fa-ticket text-green-600 mr-1"></i>
            Entry Fee: ₹<%= product.entryFee %>
          </p>

          <a href="/addtocart/<%= product._id %>"
             class="block text-center w-full py-2 bg-green-600 text-white font-semibold rounded-full hover:bg-green-700 transition">
            <i class="fa-solid fa-plus mr-1"></i>Add to Trip
          </a>
        </div>
        <a href="/products/shop/<%= product._id %>"  class="block text-center w-10px py-2 bg-red-500 text-white font-semibold rounded-full hover:bg-red-700 transition">
          
          View Details</a>
      </div>
    <% }) %>
          
  </div>
   
  <section class="map-section">
    <h2>Find Locations on Map</h2>
    <div class="map">
      <!-- Replace with your Google Maps Embed URL -->
      <iframe src="https://maps.google.com/maps?q=India&t=&z=4&ie=UTF8&iwloc=&output=embed" allowfullscreen></iframe>
    </div>
  </section>
  <%- include('./partials/footer') %>
 
  
  <script src="/javascript/shop.js"></script>
</body>
</html>
