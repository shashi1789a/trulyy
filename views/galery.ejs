<body class="bg-gray-100 text-gray-800">

  <!-- Fixed Header -->
  <div class="fixed top-0 left-0 w-full z-50 shadow-md bg-white">
    <%- include('./partials/header') %>
  </div>

  <!-- GALLERY SECTION -->
<section class="mt-20 mb-0 px-4 md:px-0 lg:px-24" style="background-color: #c3d0f1; border-radius: 1rem; padding-top: 2.5rem; padding-bottom: 2.5rem; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);">


  <h2 class="text-4xl font-extrabold text-center text-indigo-700 mb-12 tracking-wide drop-shadow-lg">✨ Travel Gallery ✨</h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
    <!-- Flip Card Template -->
    <div class="flip-card perspective cursor-pointer group" onclick="this.classList.toggle('flipped')">
      <div class="flip-card-inner relative w-full h-64 transition-transform duration-700 transform-style-preserve-3d group-hover:scale-105">
        <!-- Front -->
        <div class="flip-card-front absolute w-full h-full rounded-3xl overflow-hidden border-4 border-indigo-300 shadow-2xl">
          <img src="/image/four.jpg" alt="Beach"
               class="w-full h-full object-cover transition duration-300 group-hover:blur-[2px]" />
          <div
            class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity bg-black bg-opacity-40 rounded-3xl pointer-events-none">
            <span class="text-white text-xl font-semibold drop-shadow-md select-none">Vishnu Temple</span>
          </div>
        </div>
        <!-- Back -->
        <div
          class="flip-card-back absolute w-full h-full rounded-3xl p-6 flex flex-col justify-center items-center text-center transform rotate-y-180 shadow-2xl"
