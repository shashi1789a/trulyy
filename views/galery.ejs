</section>

<style>
  .perspective {
    perspective: 1000px;
  }

  .flip-card-inner {
    transform-style: preserve-3d;
    transition: transform 0.7s;
  }

  .flip-card.flipped .flip-card-inner {
    transform: rotateY(180deg);
  }

  .flip-card-front,
  .flip-card-back {
    backface-visibility: hidden;
  }

  .flip-card-back {
    transform: rotateY(180deg);
  }
</style>








<section class="pt-28 pb-20 px-6 bg-gradient-to-br from-purple-100 to-blue-50">
  <h2 class="text-5xl font-extrabold text-center text-indigo-700 mb-16 tracking-wider shadow-sm">✨ Tourist Memories Gallery</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">

    <!-- Card 1: Border top color + scale hover -->
    <div class="bg-white rounded-xl shadow-2xl overflow-hidden transform hover:scale-105 transition duration-300 border-t-8 border-indigo-500">
      <img src="/image/sonu1.jpg" alt="Varanasi" class="w-full h-64 object-cover">
      <div class="p-5">
        <h3 class="text-2xl font-semibold text-indigo-700 mb-2">🛶 Varanasi Ghats</h3>
        <p class="text-gray-600 text-sm">Experience the serene Ganga aarti with stunning riverside beauty.</p>
      </div>
    </div>

    <!-- Card 2: Gradient border wrapper -->
    <div class="bg-gradient-to-r from-yellow-200 via-red-100 to-pink-200 rounded-2xl p-1 shadow-xl hover:scale-105 transition duration-300">
      <div class="bg-white rounded-xl overflow-hidden">
        <img src="/image/sumit2.jpg" alt="Manali Hills" class="w-full h-64 object-cover">
        <div class="p-4">
          <h3 class="text-2xl font-bold text-rose-600">🏔️ Manali Hills</h3>
          <p class="text-sm text-gray-700">Snowy mountains and pine forests create a paradise for nature lovers.</p>
        </div>
      </div>
    </div>

    <!-- Card 3: Image blur + overlay text on hover -->
    <div class="relative group overflow-hidden rounded-xl shadow-lg border bg-white hover:shadow-2xl transition-all duration-300">
      <img src="/image/sonu4.jpg" alt="Goa Beach" class="w-full h-64 object-cover group-hover:blur-sm">
      <div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center opacity-0 group-hover:opacity-100 transition duration-300">
        <div class="text-white text-center px-4">
          <h3 class="text-2xl font-semibold mb-2">🏖️ Goa Beach</h3>
          <p class="text-sm">Golden sands, waves, and parties that never stop!</p>
        </div>
      </div>
    </div>

    <!-- Card 4: Left colored border with shadow -->
    <div class="bg-white border-l-4 border-green-400 shadow-md p-5 rounded-xl hover:shadow-xl transition-all">
      <img src="/image/sonu3.jpg" alt="Meghalaya Waterfall" class="rounded-lg mb-4 h-64 w-full object-cover">
      <h3 class="text-xl font-bold text-green-700">🌊 Meghalaya Waterfall</h3>
      <p class="text-gray-600 text-sm">Witness the raw power and elegance of nature in Meghalaya’s lush falls.</p>
    </div>

    <!-- Card 5: Dashed border + caption overlay -->
    <div class="relative border-2 border-dashed border-indigo-300 rounded-xl overflow-hidden hover:shadow-xl transition-all duration-300">
      <img src="/image/sonu2.jpg" alt="Kerala Backwaters" class="w-full h-64 object-cover">
      <div class="absolute bottom-0 left-0 bg-white bg-opacity-90 w-full p-4">
        <h3 class="text-xl font-semibold text-indigo-800">🚤 Kerala Backwaters</h3>
        <p class="text-sm text-gray-700">Relax in a houseboat with coconut groves and calm waters.</p>
      </div>
    </div>

    <!-- Card 6: Centered content, soft hover background -->
    <div class="bg-white rounded-xl p-5 shadow-xl flex flex-col items-center hover:bg-indigo-50 transition duration-300">
      <img src="/image/sonu1.jpg" alt="Taj Mahal" class="h-60 w-full object-cover rounded-md mb-3">
      <h3 class="text-xl font-bold text-indigo-900">🏛️ Taj Mahal, Agra</h3>
      <p class="text-center text-gray-600 text-sm">The symbol of eternal love and architectural magnificence.</p>
    </div>

    <!-- Card 7: Text overlay with gradient fade -->
    <div class="relative rounded-xl overflow-hidden shadow-lg group cursor-pointer">
      <img src="/image/sumit2.jpg" alt="Sunset Hills" class="w-full h-64 object-cover transition-transform duration-500 group-hover:scale-110">
      <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-70"></div>
      <div class="absolute bottom-5 left-5 text-white z-10">
        <h3 class="text-3xl font-extrabold drop-shadow-lg">🌄 Sunset Hills</h3>
        <p class="text-sm drop-shadow-md max-w-xs">Feel the calm and vibrant hues of a mountain sunset.</p>
      </div>
    </div>

    <!-- Card 8: Circular profile style with text below -->
    <div class="flex flex-col items-center p-6 bg-white rounded-full shadow-xl hover:shadow-2xl transition duration-300">
      <img src="/image/sonu3.jpg" alt="Forest Explorer" class="rounded-full w-48 h-48 object-cover mb-4 border-8 border-indigo-400">
      <h3 class="text-2xl font-semibold text-indigo-700">🌳 Forest Explorer</h3>
      <p class="text-gray-600 text-center max-w-xs mt-2">Deep woods, fresh air, and an adventure awaits in the forest trails.</p>
    </div>

    <!-- Card 9: Minimalist card with bottom border and shadow -->
    <div class="bg-white p-5 rounded-xl border-b-4 border-pink-500 shadow-md hover:shadow-lg transition duration-300">
      <img src="/image/sonu2.jpg" alt="Beach Vibes" class="rounded-lg w-full h-64 object-cover mb-4">
      <h3 class="text-xl font-bold text-pink-600">🌴 Beach Vibes</h3>
      <p class="text-gray-700 text-sm">Feel the sand between your toes and listen to the ocean breeze.</p>
    </div>

  </div>
  
</section>

<section class="pt-28 pb-20 px-6 bg-gradient-to-br from-purple-100 to-blue-50">
  <h2 class="text-5xl font-extrabold text-center text-indigo-700 mb-16 tracking-wider shadow-sm">
    ✨ Tourist Memories Gallery
