      <h3 class="text-2xl font-bold text-indigo-800 mb-1">🏖️ Coastal Bliss</h3>
      <p class="text-gray-700 text-sm">Relax by the sparkling coastal waters.</p>
    </div>

    <!-- Card 25: Animated underline on title -->
    <div class="animated-underline-card p-6 max-w-sm mx-auto bg-white rounded-xl shadow-md cursor-pointer hover:shadow-lg transition-shadow duration-300">
      <img src="/image/sonu1.jpg" alt="Underline Animation" class="rounded-lg w-full h-64 object-cover mb-4" />
      <h3 class="text-2xl font-semibold text-indigo-700 mb-2 underline-animation">🌿 Forest Trails</h3>
      <p class="text-gray-600 text-sm">Explore the peaceful trails surrounded by lush greenery.</p>
    </div>

    <!-- Card 26: Soft shadows with inset glow -->
    <div class="soft-shadow-card rounded-xl max-w-sm mx-auto p-5 bg-white shadow-lg cursor-pointer hover:shadow-inner transition-shadow duration-300">
      <img src="/image/sonu2.jpg" alt="Soft Shadows" class="rounded-lg w-full h-64 object-cover mb-4" />
      <h3 class="text-2xl font-bold text-green-700 mb-1">🌳 Nature’s Embrace</h3>
      <p class="text-gray-600 text-sm">Breathe in the fresh air and hear the birds sing.</p>
    </div>

    <!-- Card 27: Text gradient and hover zoom -->
    <div class="text-gradient-card rounded-xl overflow-hidden cursor-pointer max-w-xs mx-auto shadow-md hover:shadow-xl transition-shadow duration-300">
      <img src="/image/sonu3.jpg" alt="Text Gradient" class="w-full h-64 object-cover rounded-lg transition-transform duration-300 hover:scale-110" />
      <div class="p-4">
        <h3 class="text-3xl font-extrabold bg-gradient-to-r from-pink-500 via-purple-600 to-indigo-700 bg-clip-text text-transparent mb-1">🌸 Blossom Park</h3>
        <p class="text-gray-700 text-sm">A burst of colors in every corner.</p>
      </div>
    </div>

  </div>
  
</section>

<style>
  /* Card 22: Glassmorphism */
  .glass-card {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
  }

  /* Card 23: 3D Tilt effect using perspective and transform */
  .tilt-card {
    perspective: 1000px;
    transition: transform 0.3s ease;
  }
  .tilt-card:hover {
    transform: rotateX(10deg) rotateY(10deg);
  }

  /* Card 24: Gradient border with inner shadow */
  .gradient-border-card {
    border: 4px solid;
    border-image-slice: 1;
    border-width: 4px;
    border-image-source: linear-gradient(45deg, #6b46c1, #b83280);
    box-shadow: inset 0 0 10px rgba(107, 70, 193, 0.2);
  }

  /* Card 25: Animated underline */
  .underline-animation {
    position: relative;
    cursor: pointer;
  }
  .underline-animation::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 3px;
    background: linear-gradient(to right, #7f7fd5, #86a8e7, #91eae4);
    bottom: 0;
    left: 0;
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.3s ease;
    border-radius: 3px;
  }
  .underline-animation:hover::after {
    transform: scaleX(1);
  }

  /* Card 26: Soft shadows with inset glow */
  .soft-shadow-card {
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    transition: box-shadow 0.3s ease;
  }
  .soft-shadow-card:hover {
    box-shadow:
      inset 0 0 15px rgba(34, 197, 94, 0.5),
      0 6px 20px rgba(34, 197, 94, 0.3);
  }

  /* Card 27: Text gradient and hover zoom */
  .text-gradient-card h3 {
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    background-image: linear-gradient(45deg, #ec4899, #8b5cf6, #3b82f6);
  }
  .text-gradient-card img {
    transition: transform 0.3s ease;
  }
  .text-gradient-card:hover img {
    transform: scale(1.1);
  }
</style>





