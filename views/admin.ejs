<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* General Styling */
        body {
            background: #f4f6f9;
            font-family: 'Poppins', sans-serif;
        }

        /* Admin Container */
        .admin-container {
            max-width: 1200px;
            margin: auto;
            padding: 20px;
        }

        /* Dashboard Header */
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: white;
            padding: 15px 20px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .admin-header h2 {
            font-size: 1.8rem;
            font-weight: bold;
        }

        /* Admin Profile */
        .admin-profile {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .admin-profile img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
        }

        /* Sidebar */
        .sidebar {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
            margin-top: 20px;
        }

        .sidebar a {
            display: block;
            text-decoration: none;
            font-size: 1.2rem;
            color: #333;
            padding: 10px;
            border-radius: 5px;
            transition: 0.3s;
        }

        .sidebar a:hover {
            background: #007bff;
            color: white;
        }

        /* Admin Cards */
        .dashboard-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .card {
            background: rgba(255, 255, 255, 0.3);
            backdrop-filter: blur(15px);
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            text-align: center;
            transition: transform 0.3s ease-in-out;
        }

        .card:hover {
            transform: scale(1.05);
        }

        .card h3 {
            font-size: 1.5rem;
            font-weight: bold;
        }

        .card p {
            font-size: 1.2rem;
            color: #555;
        }

        /* Logout Button */
        .logout {
            margin-top: 20px;
            text-align: center;
        }

        .logout a {
            background: #dc3545;
            color: white;
            padding: 10px 15px;
            border-radius: 5px;
            text-decoration: none;
            transition: 0.3s;
        }

        .logout a:hover {
            background: #c82333;
        }
    </style>
</head>
<body>
    <%- include('./partials/headeroth') %>
    <div class="admin-container">

        <!-- Admin Header -->
        <div class="admin-header">
            <h2>Admin Dashboard</h2>
            <div class="admin-profile">
                <img src="<%= admin.picture %>" alt="Admin Profile">
                <span><%= admin.fullname %></span>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="sidebar">
            <a href="/admin/products"><i class="fa-solid fa-box"></i> Manage Products</a>
            <a href="/admin/orders"><i class="fa-solid fa-shopping-cart"></i> Manage Orders</a>
            <a href="/admin/users"><i class="fa-solid fa-users"></i> Manage Users</a>
            <a href="/admin/settings"><i class="fa-solid fa-cogs"></i> Settings</a>
        </div>

        <!-- Dashboard Stats -->
        <div class="dashboard-cards">
            <div class="card">
                <h3><i class="fa-solid fa-box"></i> 50</h3>
                <p>Products</p>
            </div>

            <div class="card">
                <h3><i class="fa-solid fa-shopping-cart"></i> 120</h3>
                <p>Orders</p>
            </div>

            <div class="card">
                <h3><i class="fa-solid fa-users"></i> 200</h3>
                <p>Users</p>
            </div>
        </div>

        <!-- Logout -->
        <div class="logout">
            <a href="/admin/logout"><i class="fa-solid fa-sign-out"></i> Logout</a>
        </div>

    </div>
    <%- include('./partials/footer') %>
</body>
</html>








