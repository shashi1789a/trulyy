<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In / Sign Up - Travel</title>
  
  <!-- Vendor CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #061A0B 0%, #2478f6 45%, #2b39f3 100%);
      min-height: 100vh;
      overflow-x: hidden;
    }
    
    /* Floating Orbs Animation */
    .auth-orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
      z-index: 0;
      animation: floatOrb 10s ease-in-out infinite;
    }
    
    .auth-orb-1 {
      width: 450px;
      height: 450px;
      background: radial-gradient(circle, rgba(45, 31, 236, 0.28), transparent 70%);
      top: -150px;
      right: -100px;
      animation-delay: 0s;
    }
    
    .auth-orb-2 {
      width: 350px;
      height: 350px;
      background: radial-gradient(circle, rgba(255,160,0,0.2), transparent 70%);
      bottom: -100px;
      left: -80px;
      animation-delay: 3s;
    }
    
    .auth-orb-3 {
      width: 250px;
      height: 250px;
      background: radial-gradient(circle, rgba(36, 36, 247, 0.15), transparent 70%);
      top: 40%;
      right: 15%;
      animation-delay: 6s;
    }
    
    .auth-orb-4 {
      width: 180px;
      height: 180px;
      background: radial-gradient(circle, rgba(14, 44, 240, 0.12), transparent 70%);
      bottom: 20%;
      right: 25%;
      animation-delay: 2s;
    }
    
    @keyframes floatOrb {
      0%, 100% { transform: translateY(0) scale(1); }
      50% { transform: translateY(-35px) scale(1.08); }
    }
    
    /* Auth Card */
    .auth-card {
      background: rgba(255,255,255,0.98);
      backdrop-filter: blur(10px);
      border-radius: 32px;
      padding: 2.2rem;
      box-shadow: 0 30px 60px rgba(0,0,0,0.3), 0 0 0 1px rgba(255,255,255,0.1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .auth-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 40px 70px rgba(0,0,0,0.35);
    }
    
    /* Brand Logo Area */
    .auth-logo {
      text-align: center;
      margin-bottom: 1.5rem;
    }
    
    .auth-logo-icon {
      width: 70px;
      height: 70px;
      background: linear-gradient(135deg, #2c16f7, #101ff0);
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
      box-shadow: 0 10px 25px rgba(27, 12, 243, 0.35);
      animation: logoPulse 2s ease-in-out infinite;
    }
    
    @keyframes logoPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
    
    .auth-logo-icon i {
      font-size: 2.2rem;
      color: white;
    }
    
    .auth-logo h3 {
      font-family: 'Poppins', sans-serif;
      font-weight: 800;
      font-size: 1.8rem;
      background: linear-gradient(135deg, #1518ea, #121ce0);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 0.25rem;
    }
    
    .auth-logo p {
      font-size: 0.85rem;
      color: #6B7280;
    }
    
    /* Tabs Styling */
    .auth-tabs {
      display: flex;
      gap: 12px;
      background: #F3F4F6;
      padding: 6px;
      border-radius: 60px;
      margin-bottom: 2rem;
    }
    
    .tab-btn {
      flex: 1;
      text-align: center;
      padding: 12px 20px;
      font-weight: 700;
      font-size: 0.95rem;
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.3s ease;
      background: transparent;
      color: #6B7280;
      border: none;
    }
    
    .tab-btn i {
      margin-right: 8px;
      font-size: 1rem;
    }
    
    .tab-btn.active {
      background: linear-gradient(135deg, #074bea, #2113eb);
      color: white;
      box-shadow: 0 4px 12px rgba(22, 15, 241, 0.3);
    }
    
    /* Form Container */
    .form-container {
      transition: all 0.3s ease;
    }
    
    .form-panel {
      display: none;
      animation: fadeIn 0.4s ease;
    }
    
    .form-panel.active-panel {
      display: block;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    /* Form Styles */
    .auth-form .form-group {
      margin-bottom: 1.3rem;
    }
    
    .auth-form .form-label {
      font-weight: 600;
      font-size: 0.85rem;
      color: #2720f6;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    
    .auth-form .form-label i {
      color: #1433e6;
      font-size: 0.8rem;
    }
    
    .auth-form .form-control {
      border: 1.5px solid #E5E7EB;
      border-radius: 14px;
      padding: 12px 16px;
      font-size: 0.95rem;
      transition: all 0.25s ease;
      background: #F9FAFB;
    }
    
    .auth-form .form-control:focus {
      border-color: #2812ef;
      box-shadow: 0 0 0 3px rgba(17, 24, 247, 0.15);
      background: #fff;
      outline: none;
    }
    
    .input-icon-group {
      position: relative;
    }
    
    .input-icon-group i {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: #9CA3AF;
      font-size: 1rem;
    }
    
    .input-icon-group .form-control {
      padding-left: 44px;
    }
    
    /* Password Toggle */
    .password-toggle {
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      color: #9CA3AF;
      transition: color 0.2s;
    }
    
    .password-toggle:hover {
      color: #1c5cf1;
    }
    
    /* Row for Name Fields */
    .row-custom {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    
    @media (max-width: 576px) {
      .row-custom {
        grid-template-columns: 1fr;
        gap: 0;
      }
    }
    
    /* Remember & Forgot Row */
    .auth-options {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }
    
    .form-check-input {
      cursor: pointer;
      border: 1.5px solid #D1D5DB;
    }
    
    .form-check-input:checked {
      background-color: #1c1fe7;
      border-color: #1a2ced;
    }
    
    .form-check-label {
      font-size: 0.85rem;
      color: #6B7280;
      cursor: pointer;
    }
    
    .forgot-link {
      font-size: 0.85rem;
      color: #1f1fdd;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s;
    }
    
    .forgot-link:hover {
      color: #0b45d8;
    }
    
    /* Buttons */
    .btn-auth {
      width: 100%;
      padding: 14px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 1rem;
      transition: all 0.3s ease;
      border: none;
    }
    
    .btn-auth-primary {
      background: linear-gradient(135deg, #FFA000, #FF6D00);
      color: white;
      box-shadow: 0 4px 15px rgba(255,160,0,0.35);
    }
    
    .btn-auth-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(255,160,0,0.45);
    }
    
    .btn-auth-primary:active {
      transform: translateY(0);
    }
    
    /* Divider */
    .auth-divider {
      display: flex;
      align-items: center;
      text-align: center;
      margin: 1.5rem 0;
    }
    
    .auth-divider::before,
    .auth-divider::after {
      content: '';
      flex: 1;
      border-bottom: 1px solid #E5E7EB;
    }
    
    .auth-divider span {
      padding: 0 15px;
      font-size: 0.8rem;
      color: #9CA3AF;
      font-weight: 500;
    }
    
    /* Social Buttons */
    .social-buttons {
      display: flex;
      gap: 12px;
      margin-top: 0.5rem;
    }
    
    .btn-social {
      flex: 1;
      padding: 12px;
      border-radius: 14px;
      font-weight: 600;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: all 0.25s ease;
      text-decoration: none;
      border: 1.5px solid #E5E7EB;
      background: white;
      color: #374151;
    }
    
    .btn-social:hover {
      border-color: #202af4;
      transform: translateY(-2px);
    }
    
    .btn-social i {
      font-size: 1.2rem;
    }
    
    .btn-google:hover i { color: #DB4437; }
    .btn-facebook:hover i { color: #4267B2; }
    
    /* Terms Text */
    .auth-terms {
      font-size: 0.75rem;
      color: #6B7280;
      text-align: center;
      margin-top: 1.2rem;
    }
    
    .auth-terms a {
      color: #1c3bed;
      text-decoration: none;
      font-weight: 600;
    }
    
    /* Footer Links */
    .auth-footer {
      text-align: center;
      margin-top: 1.5rem;
      padding-top: 1.2rem;
      border-top: 1px solid #E5E7EB;
    }
    
    .auth-footer p {
      font-size: 0.85rem;
      color: #0c6fe9;
      margin: 0;
    }
    
    .auth-footer a {
      color: #4d10f4;
      text-decoration: none;
      font-weight: 700;
    }
    
    .auth-footer a:hover {
      color: #2912d8;
    }
    
    /* Alert Messages */
    .alert-custom {
      border-radius: 14px;
      padding: 12px 16px;
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
      border: none;
      background: #E8F5E9;
      color: #0d28d8;
      border-left: 4px solid #320cef;
    }
    
    /* Password Strength Meter */
    .strength-meter {
      margin-top: 8px;
      height: 4px;
      background: #E5E7EB;
      border-radius: 2px;
      overflow: hidden;
    }
    
    .strength-bar {
      height: 100%;
      width: 0%;
      transition: width 0.3s, background 0.3s;
      border-radius: 2px;
    }
    
    .strength-text {
      font-size: 0.7rem;
      margin-top: 5px;
      display: block;
    }
    
    /* Navbar Minimal */
    .navbar-minimal {
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(20px);
      padding: 0.8rem 0;
      box-shadow: 0 2px 20px rgba(0,0,0,0.08);
    }
    
    .navbar-minimal .navbar-brand {
      font-weight: 800;
      font-size: 1.4rem;
      background: linear-gradient(135deg, #1c09ef, #131eea);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    
    .navbar-minimal .navbar-brand i {
      background: none;
      -webkit-text-fill-color: #1732ce;
    }
    
    .navbar-minimal .nav-link {
      color: #374151;
      font-weight: 500;
      transition: color 0.2s;
    }
    
    .navbar-minimal .nav-link:hover {
      color: #390fd2;
    }
    
    /* Responsive */
    @media (max-width: 576px) {
      .auth-card {
        padding: 1.5rem;
        margin: 0 12px;
      }
      
      .social-buttons {
        flex-direction: column;
      }
      
      .auth-logo-icon {
        width: 55px;
        height: 55px;
      }
      
      .auth-logo-icon i {
        font-size: 1.8rem;
      }
      
      .tab-btn {
        padding: 10px 16px;
        font-size: 0.85rem;
      }
    }
    
    @media (max-width: 380px) {
      .tab-btn span {
        display: none;
      }
      .tab-btn i {
        margin-right: 0;
      }
    }
  </style>
</head>
