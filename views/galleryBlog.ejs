<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Travel Gallery & Blogs</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 text-gray-800 font-sans">

  <!-- Header -->
  <%- include('./partials/headeroth') %>

  <!-- Main Section -->
  <section class="mt-32 mb-24 px-6">
    <h2 class="text-4xl font-extrabold text-center text-indigo-700 mb-12">
      🌍 Travel Gallery & Blogs
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      <% destinations.forEach(dest => { %>
        <div class="bg-white rounded-xl shadow-lg p-4 hover:shadow-xl transition-shadow duration-300">
          <img src="<%= dest.imageUrl %>" alt="<%= dest.name %>" class="w-full h-48 object-cover rounded-md mb-3" />
          
          <h3 class="text-xl font-bold text-indigo-800 mb-1"><%= dest.name %></h3>
          <p class="text-gray-600 mb-2"><%= dest.description %></p>
          <p class="text-sm text-yellow-600">⭐ Avg Rating: <%= dest.averageRating.toFixed(1) %> / 5</p>

          <% if (user) { %>
            <!-- Rating Form -->
            <form action="/destinations/<%= dest._id %>/rate" method="POST" class="mt-2">
              <label class="block text-sm font-medium text-gray-700">Rate this destination:</label>
              <select name="score" required class="border border-gray-300 p-2 rounded w-full mt-1">
                <option value="">Select rating</option>
                <option value="1">1 - Poor</option>
                <option value="2">2 - Fair</option>
                <option value="3">3 - Good</option>
                <option value="4">4 - Very Good</option>
                <option value="5">5 - Excellent</option>
              </select>
              <textarea
                name="comment"
                rows="2"
                class="w-full mt-2 border border-gray-300 rounded p-2"
                placeholder="Write a short review..."
              ></textarea>
              <button type="submit" class="mt-3 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded">
                Submit
              </button>
            </form>
          <% } else { %>
            <p class="text-sm mt-3 text-gray-500">
              Please <a href="/login" class="text-indigo-600 underline">login</a> to rate this destination.
            </p>
          <% } %>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- Footer -->
  <%- include('./partials/footer') %>

</body>
</html>
