<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsive Header</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style> 
    </style>
</head>
<body class="bg-gray-100">
    <nav class="bg-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center py-4">
                <!-- Logo -->
                <h2 class="text-2xl font-bold text-gray-800"> TOURLY</h2>
                
                <!-- Menu Links -->
                <% var loggedin = typeof loggedin !== "undefined" ? loggedin : true %>
                <% if (loggedin) { %>
                <div class="hidden md:flex space-x-6">
                    <a href="/shop" class="text-gray-600 hover:text-gray-900">Home</a>
                    <a href="/cart" class="text-gray-600 hover:text-gray-900">Add to Trip</a>
                    <a href="/destination" class="text-gray-600 hover:text-gray-900">destination</a>
                    <a href="/aboutus" class="text-gray-600 hover:text-gray-900">About us</a>
                    <a href="/galery" class="text-gray-600 hover:text-gray-900">gallery</a>
                    <a href="/contactus" class="text-gray-600 hover:text-gray-900">Contact us</a>
                    <a href="owner-login" class="text-gray-600 hover:text-gray-900">My Account</a>
                    <a href="/users/Logout" class="text-red-500 hover:text-red-700">Logout</a>
                </div>

                <!-- Mobile Menu Button -->
                <button id="menu-btn" class="md:hidden focus:outline-none">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
                    </svg>
                </button>
                <% } %>
            </div>

            <!-- Mobile Menu -->
            <% if (loggedin) { %>
            <div id="mobile-menu" class="hidden md:hidden flex flex-col space-y-4 py-2 bg-white shadow-md">
                <a href="#" class="block px-4 py-2 text-gray-600 hover:bg-gray-100">Home</a>
                <a href="/cart" class="block px-4 py-2 text-gray-600 hover:bg-gray-100">Add to Trip</a>
                <a href="#" class="block px-4 py-2 text-gray-600 hover:bg-gray-100">My Account</a>
                <a href="/users/Logout" class="block px-4 py-2 text-red-500 hover:bg-gray-100">Logout</a>
            </div>
            <% } %>
        </div>
    </nav>

    <script>
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });
    </script>
</body>
</html>
