<!DOCTYPE html>
<html lang="en" >
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Header</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @keyframes gradientShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    nav {
      position: fixed !important;
      top: 0 !important;
      left: 0;
      right: 0;
      z-index: 50;

      background: linear-gradient(270deg, #4f46e5, #9333ea, #ec4899, #f59e0b);
      background-size: 800% 800%;
      animation: gradientShift 15s ease infinite;
      transition: background-color 0.3s ease, backdrop-filter 0.3s ease, box-shadow 0.3s ease;
    }

    nav.scrolled {
      background-color: rgba(255 255 255 / 0.25);
      backdrop-filter: blur(15px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
      animation-play-state: paused;
      background-size: cover;
      background-image: linear-gradient(135deg, rgba(255 255 255 / 0.25), rgba(255 255 255 / 0.15));
    }

    .logo-text {
      background: linear-gradient(90deg, #ec4899, #f59e0b, #4f46e5);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      font-weight: 900;
      font-size: 2.75rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      text-shadow:
        2px 2px 6px rgba(0,0,0,0.15),
        0 0 15px rgba(245, 158, 11, 0.6),
        0 0 10px rgba(236, 72, 153, 0.7);
      user-select: none;
    }

    #menu-btn.open svg path:nth-child(1) {
      transform: rotate(45deg);
      transform-origin: center;
      transition: transform 0.3s ease;
    }
    #menu-btn.open svg path:nth-child(2) {
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    #menu-btn.open svg path:nth-child(3) {
      transform: rotate(-45deg);
      transform-origin: center;
      transition: transform 0.3s ease;
    }
    
    #mobile-menu.slide-down {
      animation: slideDown 0.3s forwards;
    }
    @keyframes slideDown {
      0% {
        opacity: 0;
        transform: translateY(-10px);
        height: 0;
      }
      100% {
        opacity: 1;
        transform: translateY(0);
        height: auto;
      }
    }
  </style>
</head>
<body class="bg-gray-100">
  <nav id="navbar" class="fixed w-full z-50 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center py-3">
        <!-- Logo on left -->
        <h1 class="logo-text">TOURLY</h1>

        <!-- Menu links aligned right -->
        <% var loggedin = typeof loggedin !== "undefined" ? loggedin : true %>
        <% if (loggedin) { %>
        <div class="hidden md:flex space-x-5 ml-auto">

          <a href="/home" class="px-4 py-2 rounded-full text-white bg-indigo-700 bg-opacity-80 hover:bg-opacity-100 transition-shadow shadow-md hover:shadow-xl font-semibold">Home</a>
          <a href="/addtrip" class="px-4 py-2 rounded-full text-white bg-indigo-700 bg-opacity-80 hover:bg-opacity-100 transition-shadow shadow-md hover:shadow-xl font-semibold">Add to Trip</a>
          <a href="/destination" class="px-4 py-2 rounded-full text-white bg-indigo-700 bg-opacity-80 hover:bg-opacity-100 transition-shadow shadow-md hover:shadow-xl font-semibold">Destination</a>
          <a href="/aboutus" class="px-4 py-2 rounded-full text-white bg-indigo-700 bg-opacity-80 hover:bg-opacity-100 transition-shadow shadow-md hover:shadow-xl font-semibold">About Us</a>
          <a href="/galery" class="px-4 py-2 rounded-full text-white bg-indigo-700 bg-opacity-80 hover:bg-opacity-100 transition-shadow shadow-md hover:shadow-xl font-semibold">Gallery</a>
          <a href="/contactus" class="px-4 py-2 rounded-full text-white bg-indigo-700 bg-opacity-80 hover:bg-opacity-100 transition-shadow shadow-md hover:shadow-xl font-semibold">Contact Us</a>
          <a href="/owner-login" class="px-4 py-2 rounded-full text-white bg-indigo-700 bg-opacity-80 hover:bg-opacity-100 transition-shadow shadow-md hover:shadow-xl font-semibold">My Account</a>
          <a href="/users/Logout" class="px-4 py-2 rounded-full text-red-400 bg-white bg-opacity-20 hover:bg-opacity-40 transition-shadow shadow-md hover:shadow-xl font-semibold">Logout</a>
        </div>

        <button id="menu-btn" class="md:hidden focus:outline-none text-white p-2 rounded-md hover:bg-white hover:bg-opacity-20 transition">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M4 6h16"></path>
            <path d="M4 12h16"></path>
            <path d="M4 18h16"></path>
          </svg>
        </button>
        <% } %>
      </div>

      <% if (loggedin) { %>
      <div id="mobile-menu" class="hidden md:hidden flex flex-col space-y-3 py-4 px-6 bg-white rounded-b-lg shadow-lg">
        <a href="/home" class="block px-4 py-3 rounded-full text-indigo-700 font-semibold hover:bg-indigo-100 transition">Home</a>
        <a href="/addtrip" class="block px-4 py-3 rounded-full text-indigo-700 font-semibold hover:bg-indigo-100 transition">Add to Trip</a>
        <a href="/destination" class="block px-4 py-3 rounded-full text-indigo-700 font-semibold hover:bg-indigo-100 transition">Destination</a>
        <a href="/aboutus" class="block px-4 py-3 rounded-full text-indigo-700 font-semibold hover:bg-indigo-100 transition">About Us</a>
        <a href="/galery" class="block px-4 py-3 rounded-full text-indigo-700 font-semibold hover:bg-indigo-100 transition">Gallery</a>
        <a href="/contactus" class="block px-4 py-3 rounded-full text-indigo-700 font-semibold hover:bg-indigo-100 transition">Contact Us</a>
        <a href="owner-login" class="block px-4 py-3 rounded-full text-indigo-700 font-semibold hover:bg-indigo-100 transition">My Account</a>
        <a href="/users/Logout" class="block px-4 py-3 rounded-full text-red-600 font-semibold hover:bg-red-200 transition">Logout</a>
      </div>
      <% } %>
    </div>
  </nav>

  <script>
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const navbar = document.getElementById('navbar');

    menuBtn.addEventListener('click', () => {
      menuBtn.classList.toggle('open');
      if (mobileMenu.classList.contains('hidden')) {
        mobileMenu.classList.remove('hidden');
        mobileMenu.classList.add('slide-down');
      } else {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('slide-down');
      }
    });

    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        navbar.classList.add('scrolled');
      } else {
        navbar.classList.remove('scrolled');
      }
    });
  </script>
</body>
</html>
