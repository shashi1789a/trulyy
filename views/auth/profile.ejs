<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Profile</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>
<%- include('../partials/headeroth') %>
<body class="bg-gray-100">

<div class="min-h-screen flex items-center justify-center">

    <div class="bg-white rounded-xl shadow-lg p-8 w-[450px]">

        <div class="flex flex-col items-center">

            <img
                src="<%= user.photo %>"
                class="w-28 h-28 rounded-full border-4 border-blue-500">

            <h1 class="text-3xl font-bold mt-5">
                <%= user.displayName %>
            </h1>

            <p class="text-gray-500">
                <%= user.email %>
            </p>

        </div>

        <div class="mt-8 space-y-4">

            <div class="bg-gray-100 rounded-lg p-3">
                <b>Google ID</b><br>
                <%= user.googleId %>
            </div>

            <div class="bg-gray-100 rounded-lg p-3">
                <b>Email</b><br>
                <%= user.email %>
            </div>

            <div class="bg-gray-100 rounded-lg p-3">
                <b>Name</b><br>
                <%= user.displayName %>
            </div>

        </div>

        <a href="/auth/logout"
           class="block text-center mt-8 bg-red-600 hover:bg-red-700 text-white py-3 rounded-lg">
            Logout
        </a>

    </div>

</div>
<%- include('../partials/footer') %>
</body>
</html>